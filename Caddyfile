{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Pages always revalidate so edits show immediately
	@pages path / /ar/ *.html
	header @pages Cache-Control "public, max-age=0, must-revalidate"
	# CSS/JS change with redesigns; keep their cache short
	@code path *.css *.js
	header @code Cache-Control "public, max-age=3600"
	# Fonts and images rarely change
	@media path /assets/fonts/* /assets/img/*
	header @media Cache-Control "public, max-age=2592000"

	# Same as the old Netlify rule: /home serves the homepage (Arabic too)
	rewrite /home /index.html
	rewrite /ar/home /ar/index.html
	redir /ar /ar/ 308

	# Service pages: /services/<slug> is one template filled from the CMS (Arabic: /ar/services/<slug>)
	@svcAr path_regexp ^/ar/services/[a-z0-9-]+/?$
	rewrite @svcAr /ar/service.html
	@svc path_regexp ^/services/[a-z0-9-]+/?$
	rewrite @svc /service.html

	# Arabic pages live in /ar/; a relative asset path resolved from there still finds /assets/
	@arAssets path /ar/assets/*
	uri @arAssets strip_prefix /ar

	# Build/config files sit in /srv next to the site — never serve them
	file_server {
		hide Caddyfile Dockerfile .dockerignore .git package.json package-lock.json node_modules scripts i18n
	}

	# Unknown URLs get the branded 404 page (the Arabic one under /ar/), still with a 404 status
	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			@ar path /ar/*
			rewrite @ar /ar/404.html
			rewrite * /404.html
			header Cache-Control "public, max-age=0, must-revalidate"
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}
}
